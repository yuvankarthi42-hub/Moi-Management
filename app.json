{
  "expo": {
    "name": "Moi Manager",
    "slug": "moi-manager",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moimanager",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F4F5FA",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0650"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moimanager.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach a photo of the moi entry or the function.",
        "NSCameraUsageDescription": "Take a photo while recording a moi entry.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.moimanager.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0650"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo of the moi entry or the function.",
          "cameraPermission": "Take a photo while recording a moi entry."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
