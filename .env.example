# Local development only. Gitignored. Never commit this file.

# ---------------------------------------------------------------------------
# Data layer mode
#   direct — the app opens libSQL itself. LOCAL VERIFICATION ONLY.
#   api    — the app calls a server that holds the Turso token. Production.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_DATA_MODE=direct

EXPO_PUBLIC_TURSO_URL=

# READ-WRITE token. In `direct` mode this is bundled into the client, where any
# user can read it out of the JS and reach EVERY user's rows. That is why the
# name says DEV_ONLY. Production must use EXPO_PUBLIC_DATA_MODE=api.
EXPO_PUBLIC_TURSO_TOKEN_DEV_ONLY=

# Base URL for EXPO_PUBLIC_DATA_MODE=api. Unused in direct mode.
EXPO_PUBLIC_API_URL=

# Firebase web config. These are meant to be public — they identify the
# project, they do not grant access. Access is granted by Firebase rules.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
