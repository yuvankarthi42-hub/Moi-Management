# Expo's dependency tree is not fully mirrored on the internal registry, so this
# project resolves from public npm. Zoho-scoped packages still use the mirror.
registry=https://registry.npmjs.org/
@zoho:registry=http://cm-npmregistry.csez.zohocorpin.com
@zohocharts:registry=http://cm-npmregistry.csez.zohocorpin.com
@zohodesk:registry=http://cm-npmregistry.csez.zohocorpin.com
@zohodesk-private:registry=http://cm-npmregistry.csez.zohocorpin.com
legacy-peer-deps=true
